{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://canonical.github.io/charm-relation-interfaces/interfaces/ingress_per_unit/schemas/provider.json",
    "type": "object",
    "title": "`ingress-per-unit` provider schema",
    "description": "The `ingress-per-unit` root schema comprises the entire provider databag for this interface.",
    "default": {},
    "examples": [
        {
            "ingress": "prometheus-k8s/0:\n  url: http://foo.bar:80/model_name-prometheus-k8s/0\nprometheus-k8s/1:\n  url: http://foo.bar:80/model_name-prometheus-k8s/1\n"
        }
    ],
    "required": [
        "ingress"
    ],
    "properties": {
        "ingress": {
            "$id": "#/properties/ingress",
            "type": "string",
            "title": "Ingress",
            "description": "A yaml-encoded mapping from unit names to objects with a `url` field, giving the URL at which ingress is provided for that unit.",
            "default": null,
            "examples": [
                "prometheus-k8s/0:\n  url: http://foo.bar:80/model_name-prometheus-k8s/0\nprometheus-k8s/1:\n  url: http://foo.bar:80/model_name-prometheus-k8s/1\n"
            ]
        }
    },
    "additionalProperties": false
}
